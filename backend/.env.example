# Copy to .env and adjust. Never commit the real .env (see CONTEXT.md).
DATABASE_URL=postgresql://legal:change-me@localhost:5432/legal
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# Engine integration: "stub" until Module 1's legal_engine is wired in.
ENGINE_MODE=stub
FAKE_ANALYSIS=false
LEGAL_ENGINE_MODEL_DIR=
TESSERACT_CMD=

# Stage 2: when true, analysis runs as a FastAPI background task after the
# 202 response; when false (default, and what the tests expect) it runs
# inline so the response already carries the final status.
ANALYSIS_ASYNC=false

# Comma-separated allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# Optional admin seed account created on startup when both are set.
ADMIN_EMAIL=
ADMIN_PASSWORD=
